{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "build",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "build",
                                   "HappyAlmere.slnx"
                               ],
                      "problemMatcher":  "$msCompile",
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  },
                  {
                      "label":  "test",
                      "type":  "process",
                      "command":  "powershell",
                      "args":  [
                                   "-NoProfile",
                                   "-File",
                                   "scripts/Test-Local.ps1"
                               ],
                      "problemMatcher":  "$msCompile",
                      "group":  "test"
                  },
                  {
                      "label":  "run HTTPS",
                      "type":  "process",
                      "command":  "powershell",
                      "args":  [
                                   "-NoProfile",
                                   "-File",
                                   "scripts/Start-Local.ps1"
                               ],
                      "problemMatcher":  "$msCompile"
                  }
              ]
}
