{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "HappyAlmere.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "HappyAlmere.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "run HTTPS",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "HappyAlmere_V0.1_MVC/src/HappyCity.Web",
        "--launch-profile",
        "https"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
