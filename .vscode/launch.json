{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HappyAlmere HTTPS",
      "type": "coreclr",
      "request": "launch",
      "envFile": "${workspaceFolder}/.env.runtime",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/HappyAlmere_V0.1_MVC/src/HappyCity.Web/bin/Debug/net10.0/HappyCity.Web.dll",
      "cwd": "${workspaceFolder}/HappyAlmere_V0.1_MVC/src/HappyCity.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7143;http://localhost:5143"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)"
      }
    }
  ]
}
