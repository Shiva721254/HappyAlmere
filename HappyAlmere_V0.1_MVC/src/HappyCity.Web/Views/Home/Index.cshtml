@model HappyCity.Web.ViewModels.DiscoveryViewModel
@{
    ViewData["Title"] = "Haal meer uit jouw Almere";
    var hasFilter = !string.IsNullOrEmpty(Model.Category) || !string.IsNullOrEmpty(Model.Query) || !string.IsNullOrEmpty(Model.District);
}

<section class="hero">
    <div class="wrap hero-inner">
        <p class="eyebrow">JOUW STAD. JOUW BUURT.</p>
        <h1>Haal meer uit<br>jouw Almere.</h1>
        <p class="hero-lead">Ontdek lokale plekken, activiteiten en diensten dichtbij huis.</p>
        <form method="get" asp-action="Index" class="search" role="search">
            <label for="q">Wat zoek je vandaag?</label>
            <input type="hidden" name="category" value="@Model.Category">
            @if (!string.IsNullOrEmpty(Model.District))
            {
                <input type="hidden" name="district" value="@Model.District">
            }
            <div class="search-controls">
                <input id="q" name="q" maxlength="@HappyCity.Application.DiscoveryFilter.MaximumQueryLength" value="@Model.Query"
                       aria-describedby="search-help" placeholder="Bijvoorbeeld: familie, lunch, kringloop, theater">
                <button type="submit">Zoeken</button>
            </div>
            <p id="search-help">Voer geen persoonsgegevens in.</p>
        </form>
    </div>
</section>

<section class="wrap section section-categories">
    <div class="section-head">
        <h2>Waar heb je zin in?</h2>
        @if (hasFilter)
        {
            <a class="reset-link" asp-action="Index">Filter wissen</a>
        }
    </div>
    <div class="categories">
        <a class="@(Model.Category == DiscoveryCategories.Activities ? "is-active" : null)"
           asp-action="Index" asp-route-category="@DiscoveryCategories.Activities" asp-route-district="@Model.District">☀ Activiteiten</a>
        <a class="@(Model.Category == DiscoveryCategories.Savings ? "is-active" : null)"
           asp-action="Index" asp-route-category="@DiscoveryCategories.Savings" asp-route-district="@Model.District">€ Besparen</a>
        <a class="@(Model.Category == DiscoveryCategories.Food ? "is-active" : null)"
           asp-action="Index" asp-route-category="@DiscoveryCategories.Food" asp-route-district="@Model.District">♨ Eten &amp; drinken</a>
        <a class="@(Model.Category == DiscoveryCategories.Services ? "is-active" : null)"
           asp-action="Index" asp-route-category="@DiscoveryCategories.Services" asp-route-district="@Model.District">⌂ Diensten</a>
        <a class="@(Model.Category == DiscoveryCategories.Shopping ? "is-active" : null)"
           asp-action="Index" asp-route-category="@DiscoveryCategories.Shopping" asp-route-district="@Model.District">◇ Winkelen</a>
        <a class="@(Model.Category is null && Model.District is null ? "is-active" : null)"
           asp-action="Index">Alles bekijken</a>
    </div>
    @if (Model.AvailableDistricts.Count > 1)
    {
        <div class="districts" role="region" aria-label="Filter op stadsdeel">
            <span class="districts-label">Stadsdeel:</span>
            <a class="@(Model.District is null ? "is-active" : null)"
               asp-action="Index" asp-route-category="@Model.Category" asp-route-q="@Model.Query">Alle wijken</a>
            @foreach (var dist in Model.AvailableDistricts)
            {
                <a class="@(string.Equals(Model.District, dist, StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"
                   asp-action="Index" asp-route-category="@Model.Category" asp-route-q="@Model.Query" asp-route-district="@dist">@dist</a>
            }
        </div>
    }
</section>

<section class="wrap section">
    <div class="section-head">
        <h2>Ontdek jouw Almere</h2>
        <span class="tag">@Model.Items.Count @(Model.Items.Count == 1 ? "plek" : "plekken")</span>
    </div>
    <p class="muted provenance">Onafhankelijk lokaal overzicht voor Almere — zonder reclame of tracking.</p>
    @if (Model.Category is not null || Model.District is not null)
    {
        <div class="active-filter">
            <p>
                @if (Model.Category is not null && Model.District is not null)
                {
                    @:Geselecteerd: @Model.Category · @Model.District
                }
                else if (Model.Category is not null)
                {
                    @:Geselecteerde categorie: @Model.Category
                }
                else
                {
                    @:Geselecteerd stadsdeel: @Model.District
                }
            </p>
            <a asp-action="Index">Alles tonen</a>
        </div>
    }
    <div class="cards">
        @foreach (var item in Model.Items)
        {
            <partial name="_DiscoveryCard" model="item" />
        }
    </div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <p>Geen resultaten. Probeer een andere zoekterm.</p>
            <a class="button" asp-action="Index">Alle voorbeelden</a>
        </div>
    }
    @if (Model.Items.Count == HappyCity.Application.DiscoveryFilter.MaximumResults)
    {
        <p class="muted limit-note">De eerste 100 resultaten worden getoond. Verfijn je zoekterm of kies een categorie.</p>
    }
</section>

@if (Model.NextCursor is not null)
{
    <nav class="wrap pagination" aria-label="Volgende zoekresultaten">
        <a class="button" asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-district="@Model.District" asp-route-cursor="@Model.NextCursor">Volgende resultaten</a>
    </nav>
}

<section class="wrap section">
    <div class="business-banner">
        <div>
            <h2>Ondernemer in Almere?</h2>
            <p>Ontdek hoe HappyAlmere straks lokale bedrijven helpt.</p>
        </div>
        <a class="button" asp-action="Business">Meer informatie</a>
    </div>
</section>
