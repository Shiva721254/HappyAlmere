@model DiscoveryItem
@using HappyCity.Web.ViewModels
@{
    var presentation = DiscoveryPresentation.ExtractSource(Model.Description);
    var artClass = DiscoveryPresentation.CategoryArtClass(Model.Category);
    var categoryLabel = DiscoveryPresentation.CategoryDisplayName(Model.Category);
}

<article class="card">
    <div class="art @artClass" aria-hidden="true">@Model.Icon</div>
    <div class="card-body">
        <div class="card-meta">
            <p class="eyebrow">@Model.District · @categoryLabel</p>
            <span class="card-badge">@(presentation.SourceDomain ?? "Lokaal")</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Slug))
        {
            <h3><a class="card-link" asp-controller="Home" asp-action="Detail" asp-route-slug="@Model.Slug">@Model.Title</a></h3>
        }
        else
        {
            <h3>@Model.Title</h3>
        }
        <p>@presentation.CleanDescription</p>
        @if (!string.IsNullOrEmpty(Model.Slug))
        {
            <div class="card-footer">
                <a class="card-more" asp-controller="Home" asp-action="Detail" asp-route-slug="@Model.Slug">Bekijk details →</a>
            </div>
        }
    </div>
</article>
