<!doctype html>
<html lang="nl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>@ViewData["Title"] | HappyAlmere</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <a class="skip" href="#main">Direct naar inhoud</a>
    <header class="header">
        <div class="wrap nav">
            <a class="brand" asp-controller="Home" asp-action="Index">happy<span>almere.</span></a>
            <nav aria-label="Hoofdnavigatie">
                <a asp-action="Index" asp-route-category="@DiscoveryCategories.Activities">Ontdekken</a>
                <a asp-action="Index" asp-route-category="@DiscoveryCategories.Savings">Besparen</a>
                <a asp-action="Index" asp-route-category="@DiscoveryCategories.Services">Diensten</a>
                <a class="nav-cta" asp-action="Business">Ondernemers</a>
            </nav>
        </div>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer>
        <div class="wrap footer">
            <div class="footer-brand">
                <strong>HappyAlmere</strong>
                <span class="footer-meta">Onafhankelijke stadsgids · Almere</span>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Over">Over HappyAlmere</a>
                <a asp-controller="Home" asp-action="Business">Voor ondernemers</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>
</body>
</html>
